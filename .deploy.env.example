# Configuration of one installation.
#
# scripts/gcp-setup.sh WRITES this file; scripts/deploy.sh and
# scripts/uninstall.sh READ it. You do not normally create it by hand — this
# example exists so you can see what an installation consists of, and so you
# can carry one across when upgrading to a new release.
#
# It is gitignored. The Firebase web values in it are public by design (they
# ship inside the browser bundle of every Firebase app), but the file also
# identifies your project, so treat it as configuration rather than as a secret
# and do not paste it into a public issue.

# --- required ---------------------------------------------------------------

# The Google Cloud project everything lives in.
PROJECT_ID=my-university-smartwatch

# Cloud Run, Firestore and Artifact Registry all use this one region.
# asia-southeast1 is Singapore, the closest to Vietnam.
REGION=asia-southeast1

# Cloud Run service name. Also derives the runtime service account address and
# the container image path, so changing it after installing means reinstalling.
SERVICE=smartwatch-ceo-challenge

# Firebase web app config. Baked into the browser bundle AT BUILD TIME, which
# is why each institution builds its own image rather than sharing one.
FIREBASE_API_KEY=AIza...
FIREBASE_AUTH_DOMAIN=my-university-smartwatch.firebaseapp.com
FIREBASE_APP_ID=1:123456789:web:abc123

# --- optional ---------------------------------------------------------------

# The first account to sign in with this address becomes the administrator, and
# nobody else can claim the role afterwards. Leave it empty and there is no way
# to create the first administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@university.edu

# Show the real brand names the five benchmark rivals were modelled on.
# Absent or anything other than "true" keeps the neutral descriptive names.
# Changes no coefficient and no score — see section 10 of INSTALL.md.
# NEXT_PUBLIC_USE_BRAND_NAMES=true
