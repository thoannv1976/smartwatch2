# ---------------------------------------------------------------------------
# Smartwatch CEO Challenge - environment configuration
# Copy to .env.local for local development.
# ---------------------------------------------------------------------------

# --- Firebase client config (PUBLIC by design - safe to ship to the browser) ---
# Firebase console > Project settings > Your apps > Web app > SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-side Firebase Admin ---
# On Cloud Run leave GOOGLE_APPLICATION_CREDENTIALS unset: the service account
# attached to the revision is picked up automatically (Application Default
# Credentials). Only set it for local development with a downloaded key.
GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# --- Local development against the Firebase emulators (optional) ---
# When set, both the Admin SDK and the browser SDK talk to the emulators.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Application ---
# First account to sign in with this email is promoted to ADMIN automatically.
BOOTSTRAP_ADMIN_EMAIL=
